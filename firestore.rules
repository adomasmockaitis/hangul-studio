rules_version = '2';

// Sicherheitsregeln für Hangul Studio (Cloud Firestore).
// In der Firebase-Konsole unter Firestore Database → Regeln einfügen und veröffentlichen.
// ENTWICKLER_UID durch die eigene Nutzer-ID ersetzen (Authentication → Nutzer → Spalte „Nutzer-UID“).
service cloud.firestore {
  match /databases/{database}/documents {

    // Lernstand: jede Person liest und schreibt nur ihre eigenen Daten
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /chunks/{chunk} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 300000;
      }
    }

    // „App mitverbessern“: nur angemeldet senden, ohne Nutzer-ID, Bild begrenzt; lesen nur der Entwickler
    match /contributions/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['kind', 'target', 'read', 'model', 'verdict', 'actuallyCorrect', 'image', 'app', 'createdAt'])
        && request.resource.data.kind in ['gemini-dispute', 'inputtools-wrong']
        && request.resource.data.target is string && request.resource.data.target.size() <= 40
        && request.resource.data.read is string && request.resource.data.read.size() <= 40
        && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() <= 80000))
        && request.resource.data.createdAt == request.time;
      allow read, delete: if request.auth != null && request.auth.uid == 'ENTWICKLER_UID';
    }
  }
}
